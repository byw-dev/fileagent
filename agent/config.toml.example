[server]
endpoint = "localhost:9090"
tls_ca_cert = ""

[agent]
fingerprint_file = "/var/lib/fileagent/fingerprint"
token_file = "/var/lib/fileagent/token.enc"
data_dir = "/var/lib/fileagent"

[upload]
concurrency = 3
part_size_mb = 64
queue_max_size = 10000
retry_max = 10

[metrics]
enabled = true
port = 9100

[log]
level = "info"
output = "/var/log/fileagent/agent.log"
max_size_mb = 100
max_backups = 7
