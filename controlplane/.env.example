# Control Plane required settings
DATABASE_URL=postgres://fileagent:fileagent@localhost:5432/fileagent?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-strong-secret
# Internal endpoint the CP dials for STS AssumeRole + bucket admin.
MINIO_ENDPOINT=localhost:9000
# 必须与 deploy/scripts/init-minio.sh 创建的 IAM 用户一致（脚本默认值如下）。
# 不要用 root 的 service account：MinIO 不允许 service account 调 AssumeRole，
# agent 会永远签不出 STS 凭据（IC-BUG-36）。
MINIO_ACCESS_KEY=cpAdminIAM000000000
MINIO_SECRET_KEY=cpAdminSecret00000000
NATS_URL=nats://localhost:4222

# Optional settings
# Note: DB migrations are embedded in the binary and applied automatically at
# startup — no external migrations directory or MIGRATIONS_PATH is needed.
HTTP_PORT=8080
GRPC_PORT=9090
JWT_ACCESS_TOKEN_TTL=2h
JWT_REFRESH_TOKEN_TTL=720h
MINIO_USE_SSL=false
# Client-facing endpoint returned to agents (STS payload) and used as the
# presigned-URL host. Must be reachable by browsers/agents. Both default to the
# internal MINIO_ENDPOINT / MINIO_USE_SSL when unset (D-024).
# MINIO_PUBLIC_ENDPOINT=192.168.1.10:9000
# MINIO_PUBLIC_USE_SSL=false
MINIO_ROLE_ARN=arn:aws:iam:::role/agent-role
LOG_LEVEL=info
# MinIO→CP webhook 的共享密钥，必须与 init-minio.sh 的 WEBHOOK_AUTH_TOKEN 一致。
# ⚠️ 留空则 CP 拒绝所有 webhook（对账兜底静默失效）。下面是 init-minio.sh 的默认值，
#    仅供本地开发；生产必须改成强随机值。
INTERNAL_WEBHOOK_SECRET=changeme

# Bootstrap admin settings
# If BOOTSTRAP_ADMIN_PASSWORD is empty and database has no users, controlplane
# creates admin with a random password and writes credentials to
# BOOTSTRAP_ADMIN_CREDENTIALS_FILE.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_CREDENTIALS_FILE=bootstrap_admin_credentials.txt
# Recovery mode: reset BOOTSTRAP_ADMIN_USERNAME password on startup.
# Requires BOOTSTRAP_ADMIN_PASSWORD to be set.
BOOTSTRAP_ADMIN_FORCE_RESET=false
